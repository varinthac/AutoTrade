# Copy to .env and fill in real values. .env is git-ignored — never commit real credentials.

# MT5 demo account (IC Markets or whichever broker)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Path to terminal64.exe if MT5 isn't in the default install location; leave blank to auto-detect.
MT5_TERMINAL_PATH=

# Anthropic API key — only needed from Phase 10 onward (LLM council escalation).
ANTHROPIC_API_KEY=

# Finnhub API key (finnhub.io) — economic calendar data for Risk Voice's
# news-veto check (Appendix A §1.5). NOTE: the economic-calendar endpoint
# is gated behind a paid Finnhub plan (confirmed against the free tier).
FINNHUB_API_KEY=

# Financial Modeling Prep API key (financialmodelingprep.com) — alternate
# economic calendar candidate. NOTE: economic calendar endpoint is
# premium-gated on the free tier (confirmed).
FMP_API_KEY=

# EODHD (eodhd.com) API token — third economic calendar candidate. NOTE:
# the economic-events endpoint is also gated behind a paid plan
# (confirmed against the free tier).
EODHD_API_TOKEN=

# RapidAPI key for the "Ultimate Economic Calendar" API — fourth economic
# calendar candidate. NOTE: endpoint returns 402/DEPLOYMENT_DISABLED,
# not usable (confirmed).
RAPIDAPI_KEY=

# Alpha Vantage API key (alphavantage.co) — fifth economic calendar
# candidate; access not yet verified.
ALPHAVANTAGE_API_KEY=

# Telegram bot token (t.me/BotFather) — best-effort trade/safety notifications
# (notify/telegram.py). Both this and TELEGRAM_CHAT_ID must be set, or
# notifications are silently skipped (also gated by config/base.yaml's
# notifications.enabled).
TELEGRAM_BOT_TOKEN=
# Telegram chat id to send notifications to.
TELEGRAM_CHAT_ID=
