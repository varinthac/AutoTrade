# Copy to .env and fill in real values. .env is git-ignored — never commit real credentials.

# MT5 demo account (IC Markets or whichever broker)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Path to terminal64.exe if MT5 isn't in the default install location; leave blank to auto-detect.
MT5_TERMINAL_PATH=

# Anthropic API key — only needed from Phase 10 onward (LLM council escalation).
ANTHROPIC_API_KEY=

# Finnhub API key (finnhub.io) — economic calendar data for Risk Voice's
# news-veto check (Appendix A §1.5). Phase 6b ships a stub provider that
# always fails safe (assumes news risk) until this is wired up; the real
# FinnhubNewsCalendarProvider is a planned follow-up to Phase 6b.
FINNHUB_API_KEY=
